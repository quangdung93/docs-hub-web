# Mẫu biến môi trường cho web trên EC2 (deployments/ec2/docker-compose.yml).
# Trên EC2: cp .env.ec2.example .env.ec2 rồi điền. KHÔNG commit .env.ec2.

APP_ENV=production
NEXT_PUBLIC_APP_NAME="Document Hub"
NEXT_PUBLIC_APP_ENV=production

# Backend: gọi thẳng qua docker network của stack API, không vòng ra internet.
API_URL=http://api:8080/public/api/v1

# MSW mock phải tắt ở môi trường thật.
ENABLE_MOCKS=false

# Khoá mã hoá cookie/session, tối thiểu 16 ký tự: openssl rand -base64 32
AUTH_SECRET=

# Khớp với jwt.issuer bên docs-hub-api (configs/config.ec2.yaml).
JWT_ISSUER=docs-hub-api
JWT_AUDIENCE=
