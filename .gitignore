# env files — commit only the non-secret templates
.env*.local
# ...and any copy of one: `.env.local.bak` does NOT match `.env*.local`,
# because the glob has to reach the end of the name.
.env*.local.*
.env.development.local
.env.staging.local
.env.production.local

# typescript
*.tsbuildinfo

# observability
.sentryclirc

# Env deploy EC2 — chứa secret, không commit
.env.ec2
