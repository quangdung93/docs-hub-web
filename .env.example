# ─────────────────────────────────────────────────────────────────────────────
# Document Hub — environment template. Copy to `.env.local` for local dev.
# Never commit real secrets; `.env*.local` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime env label: local | development | staging | production
APP_ENV=local

# Public (inlined into the client bundle — never put secrets here)
NEXT_PUBLIC_APP_NAME="Document Hub"
NEXT_PUBLIC_APP_ENV=local

# Upstream backend the BFF proxy forwards to (server-only).
# In local dev this points at the in-process MSW mock (Module 3+).
API_URL=http://localhost:4000

# Toggle in-process API mocking: true | false
ENABLE_MOCKS=true

# ── Auth (consumed from Module 4) ────────────────────────────────────────────
# JWT verification. Leave blank until the auth module is wired.
JWT_ISSUER=
JWT_AUDIENCE=
# 32+ char random string, used for cookie/session crypto helpers.
# Must be >= 16 chars or `core/config/env.ts` refuses to boot. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-only-secret-change-me-in-every-real-environment
